# Saved simulation playback duration per stage (0 = immediate).
SAVED_SIMULATION_STAGE_SECONDS=10

# LLM API配置（支持 OpenAI SDK 格式的任意 LLM）
# 推荐使用阿里百炼平台Qwen-plus模型：https://bailian.console.aliyun.com/
LLM_API_KEY=<YOUR_GEMINI_API_KEY>
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-3-flash-preview

# ===== Structured extraction (optional) =====
# Some providers are stricter on output moderation and may return:
#   data_inspection_failed / inappropriate content
# You can switch ONLY ontology/entity/relation extraction to another OpenAI-compatible provider/model.
# EXTRACT_API_KEY=your_extract_api_key_here
# EXTRACT_BASE_URL=https://api.openai.com/v1
# EXTRACT_MODEL_NAME=gpt-4o-mini

# ===== Report generation (optional) =====
# Some providers are stricter on INPUT moderation. Report generation may include simulated / retrieved raw text
# and get blocked by "data_inspection_failed / inappropriate content".
# You can switch ONLY report generation to another OpenAI-compatible provider/model.
# REPORT_API_KEY=your_report_api_key_here
# REPORT_BASE_URL=https://api.openai.com/v1
# REPORT_MODEL_NAME=gpt-4o-mini

# ===== 存储后端配置 =====
# zep: 使用 Zep Cloud 图谱（可能遇到免费版限流 429）
# local: 使用 Neo4j + Qdrant 本地化存储（推荐）
GRAPH_BACKEND=local
VECTOR_BACKEND=qdrant

# ===== Neo4j（GRAPH_BACKEND=local）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish
NEO4J_DATABASE=neo4j

# ===== Qdrant（VECTOR_BACKEND=qdrant）=====
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION_CHUNKS=mirofish_chunks

# ===== Embedding（默认复用 LLM 配置）=====
# 如果你的 LLM 提供方不支持 embeddings，请改用支持 embeddings 的 base_url/model，或把 VECTOR_BACKEND=none
EMBEDDING_API_KEY=<YOUR_GEMINI_API_KEY>
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL_NAME=gemini-embedding-001

# ===== GCP =====
GCP_PROJECT_ID=mirofish-496306
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# ===== ZEP（GRAPH_BACKEND=zep 时需要）=====
# 每月免费额度即可支撑使用：https://app.getzep.com/
# ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
#LLM_BOOST_API_KEY=your_boost_api_key_here
#LLM_BOOST_BASE_URL=https://another-api-provider.com/v1
#LLM_BOOST_MODEL_NAME=gpt-4o-mini

# =====Mock 模式（零 Token 测试，配置后自动拉起mock服务器用于模拟测试）=====
# USE_MOCK_LLM=true
# MOCK_LLM_URL=http://localhost:5099